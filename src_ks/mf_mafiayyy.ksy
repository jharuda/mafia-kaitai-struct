meta:
  id: mafia_format_mafiayyy
  file-extension: nnn
  endian: le

seq:
  - id: magic_number
    contents: [0x47, 0x76, 0x61, 0x53, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x25, 0x78, 0x66, 0x64, 0xDB, 0x9A, 0x8D, 0x7A]
  - id: mission_name_part_first
    type: u8
  - id: mission_name_part_second
    type: u8
  - id: save_preview
    type: u8
  - id: save_time
    type: u8
  - id: health
    type: u8
  - id: encoded_data
    type: u1
    repeat: eos